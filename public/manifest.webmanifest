{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Gogrou — B2B Manufacturing Platform",
  "short_name": "Gogrou",
  "description": "GPC katalog nástrojů + GSS provoz (sklad, kusy, pohyby) pro výrobní firmy.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "lang": "cs",
  "categories": ["business", "productivity", "utilities"],
  "background_color": "#fafaf9",
  "theme_color": "#22c55e",
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "DM Scan",
      "short_name": "Scan",
      "description": "Skenovat DM kód a získat instrukci",
      "url": "/gss/scan",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Low stock",
      "short_name": "Reorder",
      "description": "Co dochází",
      "url": "/gss/low-stock",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "GINA Insights",
      "short_name": "GINA",
      "description": "AI insights dashboard",
      "url": "/gina",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
